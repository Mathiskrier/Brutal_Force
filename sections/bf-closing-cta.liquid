{%- comment -%}
  Brutalforce: closing call-to-action at the end of the home page - heading, one line, button,
  centred on a photo (the hero's Tarifa photo, so the page opens and closes with the same image)
  with a soft dark overlay for legibility. The photo is lazy-loaded (it sits at the bottom).
{%- endcomment -%}
{%- assign overlay = section.settings.overlay | divided_by: 100.0 -%}
<div class="bf-close" style="--bf-close-overlay: {{ overlay }};">
  {%- if section.settings.image != blank -%}
    <div class="bf-close__media" aria-hidden="true">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          decoding: 'async',
          widths: '600, 900, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          alt: '',
          class: 'bf-close__img'
      }}
    </div>
  {%- endif -%}

  <div class="page-width bf-close__content">
    {%- if section.settings.heading != blank -%}
      <h2 class="bf-close__heading h1">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="bf-close__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="bf-close__button" href="{{ section.settings.button_link | default: '/collections/drinkware' }}">
        <span>{{ section.settings.button_label | escape }}</span>
        <span class="bf-close__arrow" aria-hidden="true">{{- 'icon-lucide-arrow-right.svg' | inline_asset_content -}}</span>
      </a>
    {%- endif -%}
  </div>
</div>

{% style %}
  .bf-close {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 38rem;
    overflow: hidden;
    background: rgb(18, 18, 18);
    color: #fff;
    text-align: center;
  }

  .bf-close__media {
    position: absolute;
    inset: 0;
  }

  .bf-close__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.focal }};
  }

  /* even dark wash + a little more behind the text in the middle */
  .bf-close__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 55% at 50% 50%, rgba(0, 0, 0, 0.28), transparent 75%),
      rgba(0, 0, 0, var(--bf-close-overlay, 0.35));
  }

  .bf-close__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 6.4rem;
    padding-bottom: 6.4rem;
  }

  .bf-close__heading {
    margin: 0;
    color: #fff;
    text-shadow: 0 0.2rem 1.6rem rgba(0, 0, 0, 0.25);
  }

  .bf-close__text {
    margin: 1.2rem 0 0;
    max-width: 44rem;
    font-family: var(--font-body-family);
    font-size: 1.7rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 0.1rem 1rem rgba(0, 0, 0, 0.25);
  }

  .bf-close__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 2.8rem;
    min-height: 5rem;
    padding: 0 3.2rem;
    border-radius: var(--buttons-radius-outset, 0.4rem);
    background: rgb(17, 17, 17);
    color: #fff;
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: 0.02rem;
    white-space: nowrap;
    text-decoration: none;
    box-shadow: 0 0.6rem 1.8rem rgba(0, 0, 0, 0.25);
    transition: background-color 0.15s ease;
  }

  .bf-close__button:hover {
    background: rgb(51, 51, 51);
  }

  .bf-close__arrow {
    display: inline-flex;
    width: 1.8rem;
    height: 1.8rem;
    transition: transform 0.15s ease;
  }

  .bf-close__arrow svg {
    width: 100%;
    height: 100%;
  }

  .bf-close__button:hover .bf-close__arrow {
    transform: translateX(0.3rem);
  }

  @media screen and (min-width: 750px) {
    .bf-close {
      min-height: 48rem;
    }

    .bf-close__text {
      font-size: 1.9rem;
    }

    .bf-close__button {
      margin-top: 3.2rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Closing call to action",
  "tag": "section",
  "class": "section bf-close-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background photo"
    },
    {
      "type": "text",
      "id": "focal",
      "label": "Photo focus (CSS position)",
      "default": "50% 50%",
      "info": "e.g. 50% 40% to show a bit more of the top."
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Darken photo",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to find yours?"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Pick your windspeed and join the crew."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the mugs"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Closing call to action"
    }
  ]
}
{% endschema %}
