{%- comment -%}
  Brutalforce: slim announcement bar at the very top. The whole bar links to one page (e.g. the
  Mugs collection). Messages fade from one to the next every few seconds; with
  "prefers-reduced-motion" only the first message shows (no rotation).
  Message options:
  - "Deal badge": shows a small "%" pill before the text (a deal signal, no number claimed).
  - "Only while the free shipping promo is on": hidden when Theme settings > Free shipping is off.
  - "Hide after": hidden from that date on (YYYY-MM-DD), for time-limited promos.
{%- endcomment -%}
{%- liquid
  capture fs_on
    render 'bf-free-shipping-active'
  endcapture
  assign today = 'now' | date: '%Y-%m-%d'
-%}
{%- capture messages -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.text == blank -%}{%- continue -%}{%- endif -%}
    {%- if block.settings.promo_only and fs_on != 'true' -%}{%- continue -%}{%- endif -%}
    {%- if block.settings.hide_after != blank -%}
      {%- assign end_date = block.settings.hide_after | date: '%Y-%m-%d' -%}
      {%- if end_date != blank and today > end_date -%}{%- continue -%}{%- endif -%}
    {%- endif -%}
    <li class="bf-ann__msg" {{ block.shopify_attributes }}>
      {%- if block.settings.deal_badge -%}
        <span class="bf-ann__deal" aria-hidden="true">%</span>
      {%- endif -%}
      <span>{{ block.settings.text | escape }}</span>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- if messages != blank -%}
  <bf-announcement class="bf-ann" data-interval="{{ section.settings.interval | times: 1000 }}">
    <a class="bf-ann__link" href="{{ section.settings.link | default: '/collections/drinkware' }}">
      <ul class="bf-ann__list list-unstyled" role="list">{{ messages }}</ul>
    </a>
  </bf-announcement>

  <script>
    if (!customElements.get('bf-announcement')) {
      customElements.define(
        'bf-announcement',
        class BfAnnouncement extends HTMLElement {
          connectedCallback() {
            this.items = [...this.querySelectorAll('.bf-ann__msg')];
            if (!this.items.length) return;
            this.index = 0;
            this.items[0].classList.add('is-active');
            const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (this.items.length < 2 || reduce) return;
            const interval = Number(this.dataset.interval) || 4500;
            this.timer = setInterval(() => {
              if (this.matches(':hover') || document.hidden) return; // pause while hovered / tab hidden
              this.items[this.index].classList.remove('is-active');
              this.index = (this.index + 1) % this.items.length;
              this.items[this.index].classList.add('is-active');
            }, interval);
          }

          disconnectedCallback() {
            clearInterval(this.timer);
          }
        }
      );
    }
  </script>

  {% style %}
    .bf-ann {
      display: block;
      background: {{ section.settings.background }};
      color: {{ section.settings.text_color }};
    }

    .bf-ann__link {
      display: block;
      color: inherit;
      text-decoration: none;
    }

    .bf-ann__list {
      position: relative;
      height: 3.6rem;
      margin: 0;
      padding: 0 1.5rem;
      overflow: hidden;
    }

    /* all messages stacked; only the active one is visible */
    .bf-ann__msg {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.8rem;
      padding: 0 1.5rem;
      font-family: var(--font-body-family);
      font-size: 1.25rem;
      font-weight: 500;
      letter-spacing: 0.04rem;
      line-height: 1.2;
      white-space: nowrap;
      opacity: 0;
      visibility: hidden;
      transform: translateY(0.4rem);
      transition: opacity 0.5s ease, transform 0.5s ease, visibility 0s linear 0.5s;
    }

    .bf-ann__msg.is-active {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: opacity 0.5s ease, transform 0.5s ease, visibility 0s;
    }

    /* the deal signal: a small brand-green pill with a "%" */
    .bf-ann__deal {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: none;
      min-width: 2rem;
      height: 2rem;
      padding: 0 0.5rem;
      border-radius: 0.5rem;
      background: {{ section.settings.badge_color }};
      color: rgb(18, 18, 18);
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: 0;
    }

    .bf-ann__link:hover .bf-ann__msg span:last-child {
      text-decoration: underline;
      text-underline-offset: 0.3rem;
    }

    @media screen and (min-width: 750px) {
      .bf-ann__msg {
        font-size: 1.3rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .bf-ann__msg {
        transition: none;
        transform: none;
      }
    }
  {% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Brutalforce top bar",
  "tag": "section",
  "class": "bf-ann-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "url",
      "id": "link",
      "label": "Link (whole bar)"
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Seconds per message",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Deal badge (%)",
      "default": "#02e65d"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "checkbox",
          "id": "deal_badge",
          "label": "Deal badge (%) before the text",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "promo_only",
          "label": "Only while the free shipping promo is on",
          "info": "Theme settings > Free shipping.",
          "default": false
        },
        {
          "type": "text",
          "id": "hide_after",
          "label": "Hide after (YYYY-MM-DD, optional)",
          "info": "For time-limited promos, e.g. the last day of Black Week."
        }
      ]
    }
  ]
}
{% endschema %}
