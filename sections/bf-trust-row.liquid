{%- comment -%}
  Brutalforce: "Why riders trust us" - three trust points with thin outline icons (Lucide, the same
  set as the product page bullets, cart and footer). Title in the brand heading font, point titles
  in semibold body font, descriptions in the body font. Phones: one column, icon left of the text (email kept on one line).
{%- endcomment -%}
<div
  class="bf-trow color-{{ section.settings.color_scheme }} gradient"
  style="--bf-trow-pt: {{ section.settings.padding_top }}px; --bf-trow-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="bf-trow__heading h1">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="bf-trow__list list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li class="bf-trow__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="bf-trow__icon" aria-hidden="true">
              {{- block.settings.icon | prepend: 'icon-lucide-' | append: '.svg' | inline_asset_content -}}
            </span>
          {%- endif -%}
          <div class="bf-trow__body">
            {%- if block.settings.title != blank -%}
              <h3 class="bf-trow__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="bf-trow__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% style %}
  .bf-trow {
    padding-top: calc(var(--bf-trow-pt) * 0.7);
    padding-bottom: calc(var(--bf-trow-pb) * 0.7);
  }

  .bf-trow__heading {
    margin: 0 0 2.8rem;
    text-align: center;
  }

  .bf-trow__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.4rem;
    max-width: 44rem;
    margin: 0 auto;
    padding: 0;
  }

  /* phones: icon left, text right */
  .bf-trow__item {
    display: flex;
    align-items: flex-start;
    gap: 1.6rem;
  }

  .bf-trow__icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.8rem;
    height: 4.8rem;
    border-radius: 50%;
    background: rgb(var(--color-background));
    box-shadow: inset 0 0 0 0.1rem rgba(var(--color-foreground), 0.12);
    color: rgb(var(--color-foreground));
  }

  .bf-trow__icon svg {
    width: 2.2rem;
    height: 2.2rem;
    stroke-width: 1.5;
  }

  .bf-trow__body {
    min-width: 0;
    padding-top: 0.2rem;
  }

  /* point titles: semibold body font (calmer than the bold italic section heading) */
  .bf-trow__title {
    margin: 0;
    font-family: var(--font-body-family);
    font-style: normal;
    font-weight: 600;
    font-size: 1.7rem;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: rgb(var(--color-foreground));
  }

  .bf-trow__text {
    margin-top: 0.4rem;
    font-family: var(--font-body-family);
    font-size: 1.45rem;
    line-height: 1.55;
    color: rgba(var(--color-foreground), 0.72);
  }

  .bf-trow__text p {
    margin: 0;
  }

  .bf-trow__text a {
    color: rgb(var(--color-foreground));
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 0.1rem;
    text-underline-offset: 0.3rem;
    white-space: nowrap; /* keep the email address in one piece */
  }

  .bf-trow__text a:hover {
    text-decoration-thickness: 0.2rem;
  }

  @media screen and (min-width: 750px) {
    .bf-trow {
      padding-top: var(--bf-trow-pt);
      padding-bottom: var(--bf-trow-pb);
    }

    .bf-trow__heading {
      margin-bottom: 4rem;
    }

    /* desktop: three even columns, centred */
    .bf-trow__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 4rem;
      max-width: 104rem;
    }

    .bf-trow__item {
      flex-direction: column;
      align-items: center;
      gap: 1.6rem;
      text-align: center;
    }

    .bf-trow__icon {
      width: 5.6rem;
      height: 5.6rem;
    }

    .bf-trow__icon svg {
      width: 2.4rem;
      height: 2.4rem;
    }

    .bf-trow__body {
      max-width: 30rem;
      padding-top: 0;
    }

    .bf-trow__title {
      font-size: 1.8rem;
    }

    .bf-trow__text {
      margin-top: 0.6rem;
      font-size: 1.5rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Trust points",
  "tag": "section",
  "class": "section bf-trow-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why riders trust us"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Trust point",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck (shipping)" },
            { "value": "message-circle", "label": "Chat (support)" },
            { "value": "shield-check", "label": "Shield (secure)" },
            { "value": "lock", "label": "Lock (secure)" },
            { "value": "package-check", "label": "Package" },
            { "value": "mail", "label": "Mail" },
            { "value": "clock", "label": "Clock" },
            { "value": "gift", "label": "Gift" },
            { "value": "none", "label": "None" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust points"
    }
  ]
}
{% endschema %}
