{%- comment -%}
  Brutalforce: home page reviews - trust headline, one featured review, 3 supporting reviews.
  1. Rating headline: live shop-wide Judge.me rating + count (shop metafields
     judgeme.all_reviews_rating / all_reviews_count; fallback: weighted average of the products'
     review metafields - same logic as snippets/bf-cart-trust.liquid).
  2. Featured review (settings): photo, stars, quote, name.
  3. "Review" blocks: hand-picked real reviews (copied from Judge.me), shown statically - no slider.
  4. Optional small text link to all reviews.
{%- endcomment -%}
{%- liquid
  assign review_count = shop.metafields.judgeme.all_reviews_count | plus: 0
  assign review_rating = shop.metafields.judgeme.all_reviews_rating | plus: 0
  if review_count == 0
    assign weighted = 0.0
    for p in collections.all.products limit: 50
      assign c = p.metafields.reviews.rating_count.value | default: 0
      if c > 0
        assign r = p.metafields.reviews.rating.value.rating | default: 0
        assign weighted = r | times: c | plus: weighted
        assign review_count = review_count | plus: c
      endif
    endfor
    if review_count > 0
      assign review_rating = weighted | divided_by: review_count
    endif
  endif
  assign review_rating = review_rating | round: 1
  assign fill_pct = review_rating | times: 20 | round
-%}

{%- capture star_svg -%}
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.6l2.82 6.06 6.63.78-4.9 4.54 1.3 6.55L12 17.25l-5.85 3.28 1.3-6.55-4.9-4.54 6.63-.78L12 2.6z"/></svg>
{%- endcapture -%}

<div
  class="bf-hrev color-{{ section.settings.color_scheme }} gradient"
  style="--bf-hrev-pt: {{ section.settings.padding_top }}px; --bf-hrev-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width bf-hrev__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="bf-hrev__heading h1">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if review_count > 0 -%}
      <div class="bf-hrev__summary">
        <div
          class="bf-hrev__stars bf-hrev__stars--lg"
          style="--bf-fill: {{ fill_pct }}%;"
          role="img"
          aria-label="Rated {{ review_rating }} out of 5"
        >
          <span class="bf-hrev__stars-base">{%- for i in (1..5) -%}{{ star_svg }}{%- endfor -%}</span>
          <span class="bf-hrev__stars-fill">{%- for i in (1..5) -%}{{ star_svg }}{%- endfor -%}</span>
        </div>
        <p class="bf-hrev__score">
          <span class="bf-hrev__avg">{{ review_rating }}</span>
          <span class="bf-hrev__out">out of 5 · from {{ review_count }} reviews</span>
        </p>
      </div>
    {%- endif -%}

    {%- if section.settings.featured_quote != blank -%}
      <figure class="bf-hrev__featured">
        {%- if section.settings.featured_image != blank -%}
          <div class="bf-hrev__featured-media">
            {{
              section.settings.featured_image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                decoding: 'async',
                widths: '300, 400, 600, 800',
                sizes: '(min-width: 750px) 280px, 200px',
                alt: section.settings.featured_alt,
                class: 'bf-hrev__featured-img'
            }}
          </div>
        {%- endif -%}
        <div class="bf-hrev__featured-body">
          {%- render 'bf-review-stars', rating: section.settings.featured_rating, star_svg: star_svg, size: 'md' -%}
          <blockquote class="bf-hrev__featured-quote">
            <p>“{{ section.settings.featured_quote | strip | escape }}”</p>
          </blockquote>
          <figcaption class="bf-hrev__name">{{ section.settings.featured_name | escape }}</figcaption>
        </div>
      </figure>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="bf-hrev__list list-unstyled" role="list">
        {%- for block in section.blocks -%}
          <li class="bf-hrev__card" {{ block.shopify_attributes }}>
            {%- render 'bf-review-stars', rating: block.settings.rating, star_svg: star_svg, size: 'sm' -%}
            <blockquote class="bf-hrev__quote">
              <p>“{{ block.settings.quote | strip | escape }}”</p>
            </blockquote>
            <p class="bf-hrev__name bf-hrev__name--sm">{{ block.settings.name | escape }}</p>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
      <div class="bf-hrev__more">
        <a class="bf-hrev__link" href="{{ section.settings.link_url }}">
          {{- section.settings.link_label | escape -}}
          <span class="bf-hrev__link-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% style %}
  .bf-hrev {
    padding-top: calc(var(--bf-hrev-pt) * 0.7);
    padding-bottom: calc(var(--bf-hrev-pb) * 0.7);
  }

  .bf-hrev__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .bf-hrev__heading {
    margin: 0 0 1.6rem;
    text-align: center;
  }

  /* stars: grey base + yellow fill clipped to the rating */
  .bf-hrev__stars {
    position: relative;
    display: inline-flex;
    line-height: 0;
  }

  .bf-hrev__stars svg {
    flex: none;
    width: var(--bf-star, 1.8rem);
    height: var(--bf-star, 1.8rem);
    margin-right: calc(var(--bf-star, 1.8rem) * 0.12);
  }

  .bf-hrev__stars-base {
    display: inline-flex;
    fill: rgba(var(--color-foreground), 0.14);
  }

  .bf-hrev__stars-fill {
    position: absolute;
    inset: 0 auto 0 0;
    display: inline-flex;
    width: var(--bf-fill, 100%);
    overflow: hidden;
    fill: #fcc419;
  }

  .bf-hrev__stars--lg { --bf-star: 3.4rem; }
  .bf-hrev__stars--md { --bf-star: 2.2rem; }
  .bf-hrev__stars--sm { --bf-star: 1.7rem; }

  /* 1. trust headline */
  .bf-hrev__summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .bf-hrev__score {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.2rem 1rem;
  }

  .bf-hrev__avg {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: 4.8rem;
    line-height: 1;
    letter-spacing: 0.02em;
    color: rgb(var(--color-foreground));
  }

  .bf-hrev__out {
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    color: rgba(var(--color-foreground), 0.7);
  }

  /* 2. featured review */
  .bf-hrev__featured {
    width: 100%;
    max-width: 88rem;
    margin: 3.2rem 0 0;
    padding: 2.4rem 2rem 2.8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
    border-radius: 1.6rem;
    background: rgba(var(--color-foreground), 0.04);
  }

  .bf-hrev__featured-media {
    flex: none;
    width: 20rem;
    aspect-ratio: 1 / 1;
    border-radius: 1.2rem;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.06);
  }

  .bf-hrev__featured-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bf-hrev__featured-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }

  .bf-hrev__featured-quote {
    margin: 1.4rem 0 0;
    padding: 0;
    border: 0;
  }

  .bf-hrev__featured-quote p {
    margin: 0;
    font-family: var(--font-body-family);
    font-style: normal;
    font-weight: 500;
    font-size: 2.2rem;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: rgb(var(--color-foreground));
    text-wrap: balance;
  }

  .bf-hrev__name {
    margin: 1.4rem 0 0;
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    font-weight: 600;
    color: rgb(var(--color-foreground));
  }

  /* 3. supporting reviews */
  .bf-hrev__list {
    width: 100%;
    max-width: 88rem;
    margin: 1.6rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.2rem;
  }

  .bf-hrev__card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.1);
    border-radius: 1.2rem;
    background: rgb(var(--color-background));
  }

  .bf-hrev__quote {
    margin: 1rem 0 0;
    padding: 0;
    border: 0;
    flex: 1 1 auto;
  }

  .bf-hrev__quote p {
    margin: 0;
    font-family: var(--font-body-family);
    font-style: normal;
    font-size: 1.5rem;
    line-height: 1.55;
    color: rgba(var(--color-foreground), 0.85);
  }

  .bf-hrev__name--sm {
    margin-top: 1.2rem;
    font-size: 1.4rem;
  }

  /* 4. read all */
  .bf-hrev__more {
    margin-top: 2.4rem;
  }

  .bf-hrev__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    font-weight: 600;
    color: rgba(var(--color-foreground), 0.75);
    text-decoration: underline;
    text-decoration-thickness: 0.1rem;
    text-underline-offset: 0.4rem;
  }

  .bf-hrev__link:hover {
    color: rgb(var(--color-foreground));
  }

  .bf-hrev__link-arrow {
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .bf-hrev__link:hover .bf-hrev__link-arrow {
    transform: translateX(0.3rem);
  }

  @media screen and (min-width: 750px) {
    .bf-hrev {
      padding-top: var(--bf-hrev-pt);
      padding-bottom: var(--bf-hrev-pb);
    }

    .bf-hrev__stars--lg { --bf-star: 4rem; }

    .bf-hrev__avg {
      font-size: 6rem;
    }

    .bf-hrev__out {
      font-size: 1.8rem;
    }

    .bf-hrev__featured {
      flex-direction: row;
      align-items: center;
      gap: 4rem;
      margin-top: 4rem;
      padding: 3.2rem 4.8rem 3.2rem 3.2rem;
      text-align: left;
    }

    .bf-hrev__featured-media {
      width: 28rem;
    }

    .bf-hrev__featured-body {
      align-items: flex-start;
    }

    .bf-hrev__featured-quote p {
      font-size: 2.8rem;
      text-wrap: pretty;
    }

    .bf-hrev__name {
      font-size: 1.6rem;
    }

    .bf-hrev__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.6rem;
      margin-top: 1.6rem;
    }

    .bf-hrev__card {
      padding: 2.4rem;
    }

    .bf-hrev__name--sm {
      font-size: 1.4rem;
    }

    .bf-hrev__more {
      margin-top: 3.2rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Home reviews",
  "tag": "section",
  "class": "section bf-hrev-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)",
      "info": "Shown above the stars in the brand font. The rating and review count are live from Judge.me."
    },
    {
      "type": "header",
      "content": "Featured review"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "featured_alt",
      "label": "Photo description (alt text)"
    },
    {
      "type": "range",
      "id": "featured_rating",
      "label": "Stars",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "textarea",
      "id": "featured_quote",
      "label": "Quote",
      "info": "Quotation marks are added automatically."
    },
    {
      "type": "text",
      "id": "featured_name",
      "label": "Name"
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "default": "Read all reviews"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 6,
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "info": "Use a real review (copied from Judge.me). Quotation marks are added automatically."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home reviews"
    }
  ]
}
{% endschema %}
