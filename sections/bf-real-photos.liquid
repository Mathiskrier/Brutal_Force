{%- comment -%}
  Brutalforce: "Out in the wild" - real customer photos (social proof).
  Layout: "Featured" photos (people) large on top, the other photos as small square thumbnails.
  Mobile: both rows swipe sideways (scroll-snap) so the section stays short.
  Layout "Grid" (home page): the Featured photos large side by side on top, all other photos
  in a much smaller square grid below (4 columns, phones and desktop).
  Each "Photo" block renders via snippets/bf-wild-photo.liquid (editor image or pre-compressed
  theme assets). All images are lazy-loaded (loading="lazy"). The CTA scrolls to the
  Add to cart button on product pages and falls back to its link everywhere else.
{%- endcomment -%}
{%- liquid
  assign featured_sizes = '(max-width: 749px) 78vw, (max-width: 989px) 31vw, 380px'
  assign thumb_sizes = '(max-width: 749px) 30vw, (max-width: 989px) 14vw, 170px'
  assign grid_top_sizes = '(max-width: 749px) 46vw, (max-width: 989px) 40vw, 360px'
  assign grid_small_sizes = '(max-width: 749px) 23vw, (max-width: 989px) 18vw, 170px'
  assign thumb_count = 0
  for block in section.blocks
    unless block.settings.featured
      assign thumb_count = thumb_count | plus: 1
    endunless
  endfor
-%}

<div class="bf-wild color-{{ section.settings.color_scheme }} gradient" style="--bf-wild-pt: {{ section.settings.padding_top }}px; --bf-wild-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="bf-wild__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="bf-wild__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="bf-wild__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.layout == 'grid' -%}
      <ul class="bf-wild__grid bf-wild__grid--top list-unstyled" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.featured -%}
            {%- render 'bf-wild-photo', block: block, sizes: grid_top_sizes, class: 'bf-wild__item--top' -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if thumb_count > 0 -%}
        <ul class="bf-wild__grid bf-wild__grid--small list-unstyled" role="list">
          {%- for block in section.blocks -%}
            {%- unless block.settings.featured -%}
              {%- render 'bf-wild-photo', block: block, sizes: grid_small_sizes, class: 'bf-wild__item--small' -%}
            {%- endunless -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- else -%}
    <ul class="bf-wild__featured bf-wild__scroller list-unstyled" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.featured -%}
          {%- render 'bf-wild-photo', block: block, sizes: featured_sizes, class: 'bf-wild__item--featured' -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if thumb_count > 0 -%}
      <ul class="bf-wild__thumbs bf-wild__scroller list-unstyled" role="list" style="--bf-wild-thumbs: {{ thumb_count }};">
        {%- for block in section.blocks -%}
          {%- unless block.settings.featured -%}
            {%- render 'bf-wild-photo', block: block, sizes: thumb_sizes, class: 'bf-wild__item--thumb' -%}
          {%- endunless -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="bf-wild__cta-wrap">
        <a
          class="bf-wild__cta"
          href="{{ section.settings.button_link | default: '/collections/drinkware' }}"
          data-bf-scroll-to-buy
        >
          <span>{{ section.settings.button_label | escape }}</span>
          <span class="bf-wild__cta-arrow" aria-hidden="true">{{- 'icon-lucide-arrow-right.svg' | inline_asset_content -}}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (() => {
    const link = document.querySelector('#shopify-section-{{ section.id }} [data-bf-scroll-to-buy]');
    if (!link || link.dataset.bound) return;
    link.dataset.bound = 'true';
    link.addEventListener('click', (event) => {
      // On product pages: scroll smoothly to the Add to cart button instead of leaving the page
      const button = document.querySelector('.product-form__submit');
      if (!button) return;
      event.preventDefault();
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      button.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
      setTimeout(() => button.focus({ preventScroll: true }), reduce ? 0 : 600);
    });
  })();
</script>

{% style %}
  .bf-wild {
    padding-top: calc(var(--bf-wild-pt) * 0.75);
    padding-bottom: calc(var(--bf-wild-pb) * 0.75);
  }

  .bf-wild__header {
    max-width: 60rem;
    margin: 0 auto 2.4rem;
    text-align: center;
  }

  .bf-wild__heading {
    margin: 0;
    font-family: var(--font-body-family);
    font-style: normal;
    font-weight: 600;
    font-size: 2.4rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .bf-wild__text {
    margin: 0.8rem 0 0;
    color: rgba(var(--color-foreground), 0.65);
    font-size: 1.5rem;
    line-height: 1.55;
  }

  .bf-wild__featured,
  .bf-wild__thumbs {
    margin: 0;
    padding: 0;
  }

  .bf-wild__item {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.05);
    transform: translateZ(0); /* keeps the rounded corners clean in Safari */
  }

  .bf-wild__item--featured {
    aspect-ratio: 3 / 4;
  }

  .bf-wild__item--thumb {
    aspect-ratio: 1 / 1;
    border-radius: 0.8rem;
  }

  .bf-wild__item picture {
    display: block;
    height: 100%;
  }

  .bf-wild__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Mobile: swipe rows, full-bleed with the next photo peeking in */
  .bf-wild__scroller {
    display: flex;
    gap: 0.8rem;
    margin-left: -1.5rem;
    margin-right: -1.5rem;
    padding: 0 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 1.5rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .bf-wild__scroller::-webkit-scrollbar {
    display: none;
  }

  .bf-wild__scroller > .bf-wild__item {
    scroll-snap-align: start;
  }

  .bf-wild__item--featured {
    flex: 0 0 78%;
  }

  .bf-wild__thumbs {
    margin-top: 0.8rem;
  }

  .bf-wild__item--thumb {
    flex: 0 0 30%;
  }

  /* Grid layout: big featured photos on top (3:4, their own shape), small square grid below */
  .bf-wild__grid {
    display: grid;
    gap: 0.8rem;
    margin: 0 auto;
    padding: 0;
    max-width: 72rem;
  }

  .bf-wild__grid--top {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .bf-wild__grid--small {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 0.8rem;
  }

  .bf-wild__item--top {
    aspect-ratio: 3 / 4;
    border-radius: 1rem;
  }

  .bf-wild__item--small {
    aspect-ratio: 1 / 1;
    border-radius: 0.8rem;
  }

  .bf-wild__cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: 2.4rem;
  }

  .bf-wild__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    min-height: 5rem;
    padding: 0 3.2rem;
    border-radius: var(--buttons-radius-outset, 0.4rem);
    background: rgb(17, 17, 17);
    color: #fff;
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: 0.02rem;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .bf-wild__cta:hover {
    background: rgb(51, 51, 51);
  }

  .bf-wild__cta-arrow {
    display: inline-flex;
    width: 1.8rem;
    height: 1.8rem;
    transition: transform 0.15s ease;
  }

  .bf-wild__cta-arrow .icon,
  .bf-wild__cta-arrow svg {
    width: 100%;
    height: 100%;
  }

  .bf-wild__cta:hover .bf-wild__cta-arrow {
    transform: translateX(0.3rem);
  }

  @media screen and (min-width: 750px) {
    .bf-wild {
      padding-top: var(--bf-wild-pt);
      padding-bottom: var(--bf-wild-pb);
    }

    .bf-wild__header {
      margin-bottom: 3.2rem;
    }

    .bf-wild__heading {
      font-size: 2.8rem;
    }

    .bf-wild__text {
      font-size: 1.6rem;
    }

    .bf-wild__scroller {
      margin: 0;
      padding: 0;
      overflow: visible;
    }

    .bf-wild__featured {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.2rem;
      max-width: 116rem;
      margin: 0 auto;
    }

    .bf-wild__item--featured {
      border-radius: 1.2rem;
    }

    .bf-wild__thumbs {
      display: grid;
      grid-template-columns: repeat(var(--bf-wild-thumbs, 7), minmax(0, 1fr));
      gap: 1.2rem;
      max-width: 116rem;
      margin: 1.2rem auto 0;
    }

    .bf-wild__cta-wrap {
      margin-top: 3.2rem;
    }

    .bf-wild__grid--top {
      gap: 1.2rem;
    }

    .bf-wild__grid--small {
      gap: 1rem;
      margin-top: 1.2rem;
    }

    .bf-wild__item--top {
      border-radius: 1.2rem;
    }

    .bf-wild__item--small {
      border-radius: 1rem;
    }
  }

{% endstyle %}

{% schema %}
{
  "name": "Real photos",
  "tag": "section",
  "class": "section bf-wild-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Out in the wild"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Real mugs, real mornings, sent in by riders across Europe. No studio, no stock — just the crew."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "rows",
          "label": "Large photos + small thumbnails (swipe on phones)"
        },
        {
          "value": "grid",
          "label": "Featured large on top + small grid below"
        }
      ],
      "default": "rows"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get yours"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/drinkware",
      "info": "Used where there is no Add to cart button on the page. On product pages the button scrolls to Add to cart."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Pick a new photo here. Leave empty to use the built-in photo below."
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured (large, shown first)",
          "info": "Use for photos with people in them. Others show as small thumbnails.",
          "default": false
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text (describe the photo)"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Built-in photo (asset name)",
          "info": "Advanced: name of the pre-compressed photo set, e.g. wild-01."
        },
        {
          "type": "number",
          "id": "width",
          "label": "Built-in photo width (px)"
        },
        {
          "type": "number",
          "id": "height",
          "label": "Built-in photo height (px)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Real photos"
    }
  ]
}
{% endschema %}
