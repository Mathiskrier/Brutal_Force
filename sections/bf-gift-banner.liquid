{%- comment -%}
  Brutalforce: gift call-to-action banner (home page). Text only, centred in a brand-yellow card:
  title, one line, a short check list, one button.
  "Point" blocks marked "Promo" only show while the free shipping promo is on
  (snippets/bf-free-shipping-active.liquid), so time-limited claims disappear with the promo.
{%- endcomment -%}
{%- liquid
  capture fs_on
    render 'bf-free-shipping-active'
  endcapture
-%}
<div
  class="bf-gift"
  style="--bf-gift-pt: {{ section.settings.padding_top }}px; --bf-gift-pb: {{ section.settings.padding_bottom }}px; --bf-gift-bg: {{ section.settings.background }};"
>
  <div class="page-width">
    <div class="bf-gift__card">
      {%- if section.settings.heading != blank -%}
        <h2 class="bf-gift__heading h1">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="bf-gift__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- capture points -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.text == blank -%}{%- continue -%}{%- endif -%}
          {%- if block.settings.promo and fs_on != 'true' -%}{%- continue -%}{%- endif -%}
          <li class="bf-gift__point" {{ block.shopify_attributes }}>
            <span class="bf-gift__check" aria-hidden="true">{{- 'icon-lucide-check.svg' | inline_asset_content -}}</span>
            <span>{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      {%- endcapture -%}
      {%- if points != blank -%}
        <ul class="bf-gift__points list-unstyled" role="list">{{ points }}</ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a class="bf-gift__button" href="{{ section.settings.button_link | default: '/collections/drinkware' }}">
          <span>{{ section.settings.button_label | escape }}</span>
          <span class="bf-gift__arrow" aria-hidden="true">{{- 'icon-lucide-arrow-right.svg' | inline_asset_content -}}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .bf-gift {
    padding-top: calc(var(--bf-gift-pt) * 0.7);
    padding-bottom: calc(var(--bf-gift-pb) * 0.7);
  }

  .bf-gift__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 88rem;
    margin: 0 auto;
    padding: 4rem 2.4rem;
    border-radius: 1.6rem;
    background: var(--bf-gift-bg, #fce477);
    color: rgb(18, 18, 18);
    text-align: center;
  }

  .bf-gift__heading {
    margin: 0;
    color: rgb(18, 18, 18);
  }

  .bf-gift__text {
    margin: 1.2rem 0 0;
    max-width: 52rem;
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    line-height: 1.6;
    color: rgba(18, 18, 18, 0.85);
  }

  /* check list: left-aligned rows inside a centred block, so the ticks line up */
  .bf-gift__points {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin: 2.4rem 0 0;
    padding: 0;
    text-align: left;
  }

  .bf-gift__point {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.4;
    color: rgb(18, 18, 18);
  }

  .bf-gift__check {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: rgb(18, 18, 18);
    color: #fff;
  }

  .bf-gift__check svg {
    width: 1.3rem;
    height: 1.3rem;
    stroke-width: 3;
  }

  .bf-gift__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    align-self: stretch;
    margin-top: 2.8rem;
    min-height: 5rem;
    padding: 0 3.2rem;
    border-radius: var(--buttons-radius-outset, 0.4rem);
    background: rgb(17, 17, 17);
    color: #fff;
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: 0.02rem;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .bf-gift__button:hover {
    background: rgb(51, 51, 51);
  }

  .bf-gift__arrow {
    display: inline-flex;
    width: 1.8rem;
    height: 1.8rem;
    transition: transform 0.15s ease;
  }

  .bf-gift__arrow svg {
    width: 100%;
    height: 100%;
  }

  .bf-gift__button:hover .bf-gift__arrow {
    transform: translateX(0.3rem);
  }

  @media screen and (min-width: 750px) {
    .bf-gift {
      padding-top: var(--bf-gift-pt);
      padding-bottom: var(--bf-gift-pb);
    }

    .bf-gift__card {
      padding: 5.6rem 6.4rem;
    }

    .bf-gift__text {
      font-size: 1.7rem;
    }

    .bf-gift__points {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem 2.8rem;
      margin-top: 2.8rem;
    }

    .bf-gift__button {
      align-self: center;
      margin-top: 3.2rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Gift banner",
  "tag": "section",
  "class": "section bf-gift-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gift season is here"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get the perfect gift"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Card colour",
      "default": "#fce477"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Check point",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "checkbox",
          "id": "promo",
          "label": "Promo (time-limited)",
          "info": "Shown only while the free shipping promo is on (Theme settings > Free shipping).",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift banner"
    }
  ]
}
{% endschema %}
