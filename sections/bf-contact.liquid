{%- comment -%}
  Brutalforce: contact page - intro + contact details on the left, the contact form on the right
  (stacked on phones). Same form and fields as the theme's contact form (sections/contact-form.liquid).
{%- endcomment -%}
{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign email = section.settings.email | strip
-%}

<div class="bf-contact color-{{ section.settings.color_scheme }} gradient" style="--bf-contact-pt: {{ section.settings.padding_top }}px; --bf-contact-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width bf-contact__grid">
    <div class="bf-contact__intro">
      {%- if section.settings.heading != blank -%}
        <h1 class="bf-contact__heading h1">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="bf-contact__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      <ul class="bf-contact__details list-unstyled" role="list">
        {%- if email != blank -%}
          <li>
            <span class="bf-contact__icon" aria-hidden="true">{{- 'icon-lucide-mail.svg' | inline_asset_content -}}</span>
            <a href="mailto:{{ email }}" class="bf-contact__email">{{ email | escape }}</a>
          </li>
        {%- endif -%}
        {%- if section.settings.reply_time != blank -%}
          <li>
            <span class="bf-contact__icon" aria-hidden="true">{{- 'icon-lucide-clock.svg' | inline_asset_content -}}</span>
            <span>{{ section.settings.reply_time | escape }}</span>
          </li>
        {%- endif -%}
        {%- if section.settings.trust_line != blank -%}
          <li>
            <span class="bf-contact__icon" aria-hidden="true">{{- 'icon-lucide-map-pin.svg' | inline_asset_content -}}</span>
            <span>{{ section.settings.trust_line | escape }}</span>
          </li>
        {%- endif -%}
      </ul>
    </div>

    <div class="bf-contact__card contact">
      <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
    {%- form 'contact', id: 'ContactForm', class: 'isolate bf-contact__form' -%}
      {%- if form.posted_successfully? -%}
        <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
          {{- 'icon-success.svg' | inline_asset_content -}}
          {{ 'templates.contact.form.post_success' | t }}
        </h2>
      {%- elsif form.errors -%}
        <div class="form__message">
          <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
            {{- 'icon-error.svg' | inline_asset_content -}}
            {{ 'templates.contact.form.error_heading' | t }}
          </h2>
        </div>
        <ul class="form-status-list caption-large" role="list">
          <li>
            <a href="#ContactForm-email" class="link">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </a>
          </li>
        </ul>
      {%- endif -%}
      <div class="contact__fields">
        <div class="field">
          <input
            class="field__input"
            autocomplete="name"
            type="text"
            id="ContactForm-name"
            name="contact[{{ 'templates.contact.form.name' | t }}]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="{{ 'templates.contact.form.name' | t }}"
          >
          <label class="field__label" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
        </div>
        <div class="field field--with-error">
          <input
            autocomplete="email"
            type="email"
            id="ContactForm-email"
            class="field__input"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-email-error"
            {% endif %}
            placeholder="{{ 'templates.contact.form.email' | t }}"
          >
          <label class="field__label" for="ContactForm-email">
            {{- 'templates.contact.form.email' | t }}
            <span aria-hidden="true">*</span></label
          >
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="ContactForm-email-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              <span class="form__message">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </small>
          {%- endif -%}
        </div>
      </div>
      <div class="field">
        <input
          type="tel"
          id="ContactForm-phone"
          class="field__input"
          autocomplete="tel"
          name="contact[{{ 'templates.contact.form.phone' | t }}]"
          pattern="[0-9\-]*"
          value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          placeholder="{{ 'templates.contact.form.phone' | t }}"
        >
        <label class="field__label" for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
      </div>
      <div class="field">
        <textarea
          rows="6"
          id="ContactForm-body"
          class="text-area field__input"
          name="contact[{{ 'templates.contact.form.comment' | t }}]"
          placeholder="{{ 'templates.contact.form.comment' | t }}"
        >
          {{- form.body -}}
        </textarea>
        <label class="form__label field__label" for="ContactForm-body">
          {{- 'templates.contact.form.comment' | t -}}
        </label>
      </div>
      <div class="contact__button">
        <button type="submit" class="button bf-contact__send">
          {{ 'templates.contact.form.send' | t }}
        </button>
      </div>
    {%- endform -%}
    </div>
  </div>
</div>

{% style %}
  .bf-contact {
    padding-top: calc(var(--bf-contact-pt) * 0.75);
    padding-bottom: calc(var(--bf-contact-pb) * 0.75);
    --inputs-radius: 0.8rem;
    --inputs-radius-outset: 0.9rem;
  }

  .bf-contact__grid {
    display: grid;
    gap: 2.8rem;
    max-width: 104rem;
  }

  .bf-contact__heading {
    margin: 0 0 1.2rem;
  }

  .bf-contact__text,
  .bf-contact__text p {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.8);
  }

  .bf-contact__text p + p {
    margin-top: 0.6rem;
  }

  .bf-contact__details {
    margin: 2rem 0 0;
    padding: 1.4rem 1.6rem;
    border-radius: 1rem;
    background: rgba(var(--color-foreground), 0.04);
  }

  .bf-contact__details li {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.45rem;
    line-height: 1.45;
    color: rgba(var(--color-foreground), 0.8);
  }

  .bf-contact__details li + li {
    margin-top: 0.8rem;
  }

  .bf-contact__icon {
    display: inline-flex;
    flex: none;
    width: 1.8rem;
    height: 1.8rem;
    color: rgb(var(--color-foreground));
  }

  .bf-contact__icon svg {
    width: 100%;
    height: 100%;
  }

  .bf-contact__email {
    color: rgb(var(--color-foreground));
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  .bf-contact__card {
    padding: 0;
  }

  .bf-contact__form .field {
    margin-bottom: 1.2rem;
  }

  .bf-contact .contact__fields {
    gap: 0 1.2rem;
  }

  .bf-contact .contact__button {
    margin-top: 0.4rem;
  }

  /* Send: brand black, like the product page Add to cart */
  .bf-contact .bf-contact__send.button {
    --color-button: 17, 17, 17;
    --color-button-text: 255, 255, 255;
    --alpha-button-background: 1;
    width: 100%;
    min-height: 5rem;
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: 0.04rem;
  }

  .bf-contact .bf-contact__send.button::before,
  .bf-contact .bf-contact__send.button::after {
    box-shadow: none;
  }

  .bf-contact .bf-contact__send.button:hover {
    --color-button: 51, 51, 51;
  }

  @media screen and (min-width: 750px) {
    .bf-contact {
      padding-top: var(--bf-contact-pt);
      padding-bottom: var(--bf-contact-pb);
    }

    .bf-contact__card {
      padding: 2.8rem;
      border: 0.1rem solid rgba(var(--color-foreground), 0.1);
      border-radius: 1.2rem;
    }
  }

  @media screen and (min-width: 990px) {
    .bf-contact__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 5.6rem;
      align-items: start;
    }

    .bf-contact__intro {
      padding-top: 1.2rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Contact (intro + form)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reach out to us" },
    { "type": "richtext", "id": "text", "label": "Intro text" },
    { "type": "text", "id": "email", "label": "Email address", "default": "contact@brutal-force.com" },
    { "type": "text", "id": "reply_time", "label": "Reply time line", "default": "We usually reply within a few hours." },
    { "type": "text", "id": "trust_line", "label": "Trust line" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 52 }
  ],
  "presets": [{ "name": "Contact (intro + form)" }]
}
{% endschema %}
