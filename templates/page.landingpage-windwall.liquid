};

function wRGB(kn){
  if(kn<=10)return[160,160,160];
  if(kn<=13)return[140,215,110];
  if(kn<=16)return[50,175,50];
  if(kn<=19)return[35,140,35];
  if(kn<=23)return[160,205,0];
  if(kn<=27)return[255,205,0];
  if(kn<=32)return[255,130,0];
  if(kn<=37)return[255,50,175];
  return[255,30,30];
}

const SPOTS=[
  {name:'TARIFA',      wind:25,gust:36,dir:'SW',swell:'1.2m',angle:225},
  {name:'HOOKIPA',     wind:15,gust:32,dir:'N', swell:'3.0m',angle:0},
  {name:'FUERTE',      wind:19,gust:28,dir:'NW',swell:'1.6m',angle:315},
  {name:'DAKHLA',      wind:31,gust:42,dir:'NE',swell:'0.8m',angle:45},
  {name:'CABARETE',    wind:22,gust:30,dir:'E', swell:'1.0m',angle:90},
];

let buf=new Uint8ClampedArray(W*H*4);
function clear(){for(let i=0;i<buf.length;i+=4){buf[i]=5;buf[i+1]=5;buf[i+2]=5;buf[i+3]=255;}}
function sp(x,y,r,g,b){
  x=Math.round(x);y=Math.round(y);
  if(x<0||x>=W||y<0||y>=H)return;
  const i=(y*W+x)*4;buf[i]=r;buf[i+1]=g;buf[i+2]=b;
}

function txt(str,x,y,r,g,b,sc){
  sc=sc||1;let cx=x;
  for(let ci=0;ci<str.length;ci++){
    const gl=F[str[ci].toUpperCase()]||F[' '];
    for(let c=0;c<5;c++){
      const cd=gl[c];
      for(let rw=0;rw<7;rw++){
        if(cd&(1<<(6-rw))){
          for(let sy=0;sy<sc;sy++)
            for(let sx=0;sx<sc;sx++)
              sp(cx+c*sc+sx,y+rw*sc+sy,r,g,b);
        }
      }
    }
    cx+=(5+1)*sc;
    if(cx+5*sc>W)break;
  }
  return cx; // return end x
}

function drawArrow(cx,cy,angleDeg,r,g,b,len){
  const a=angleDeg*Math.PI/180;
  const tx=Math.round(cx+Math.cos(a)*len);
  const ty=Math.round(cy+Math.sin(a)*len);
  const dx=tx-cx,dy=ty-cy;
  const steps=Math.max(Math.abs(dx),Math.abs(dy),1);
  for(let i=0;i<=steps;i++){
    const px=Math.round(cx+dx*i/steps);
    const py=Math.round(cy+dy*i/steps);
    sp(px,py,r,g,b);sp(px+1,py,r,g,b);
    sp(px,py+1,r,g,b);sp(px+1,py+1,r,g,b);
  }
}

function wave(y0,seed){
  for(let x=180;x<W-1;x++){
    const wy=y0+Math.sin((x*0.5+seed)*0.28)*4+Math.sin((x*0.3+seed)*0.18)*2.5;
    const cy=Math.max(2,Math.min(H-3,Math.round(wy)));
    sp(x,cy,255,255,255);sp(x+1,cy,255,255,255);
  }
  const dx=210;
  const dwy=y0+Math.sin((dx*0.5+seed)*0.28)*4+Math.sin((dx*0.3+seed)*0.18)*2.5;
  const dcy=Math.max(2,Math.min(H-3,Math.round(dwy)));
  for(let yy=-2;yy<=2;yy++)for(let xx=-2;xx<=2;xx++)sp(dx+xx,dcy+yy,255,255,255);
}

function divider(y){
  for(let x=0;x<W;x+=3){sp(x,y,40,40,40);sp(x+1,y,40,40,40);}
}

// History takes bottom 35px: from y=88 to y=123
function history(hist,wind){
  const baseY=108, amp=14;
  for(let i=0;i<hist.length;i++){
    const x=i*4; if(x>W-4)break;
    const v=hist[i];
    const[r,g,b]=wRGB(v);
    const curve=Math.round(Math.sin(i*0.22)*3);
    const normY=Math.round(((v-8)/32)*amp);
    const py=Math.max(baseY-amp,Math.min(baseY,baseY-normY+curve));
    sp(x,py,r,g,b);sp(x+1,py,r,g,b);
    sp(x+2,py,r,g,b);sp(x+3,py,r,g,b);
  }
  const[lr,lg,lb]=wRGB(wind);
  const lx=Math.min(W-7,(hist.length-1)*4);
  const lv=hist[hist.length-1]||wind;
  const lc=Math.round(Math.sin((hist.length-1)*0.22)*3);
  const ln=Math.round(((lv-8)/32)*amp);
  const ly=Math.max(baseY-amp,Math.min(baseY,baseY-ln+lc));
  for(let yy=-3;yy<=3;yy++)for(let xx=-3;xx<=3;xx++)sp(lx+xx,ly+yy,lr,lg,lb);
}

function timeLabels(){
  const labs=['-6h','-5h','-4h','-3h','-2h','-1h','NOW'];
  labs.forEach(function(l,i){
    const x=Math.round(2+i*((W-16)/6));
    sp(x,118,30,30,30);sp(x+1,118,30,30,30);
    txt(l,Math.max(0,x-3),121,38,38,38,1);
  });
}

function render(spot,hist){
  clear();
  const[wr,wg,wb]=wRGB(spot.wind);
  const[gr,gg,gb]=wRGB(spot.gust);

  // ── ROW 1: Spot name sc=3, Live dot top right ──
  txt(spot.name,4,2,205,205,205,3);

  // Live dot — big enough to see
  for(let yy=0;yy<4;yy++)for(let xx=0;xx<4;xx++)sp(228+xx,3+yy,210,40,0);
  txt('LIVE',235,4,65,65,65,2);

  // ── ROW 2: arrow + wind sc=4 + KN + gust sc=4 + dir + swell + wave ──
  // Arrow
  drawArrow(6,52,spot.angle,190,190,190,10);

  // Wind — scale 4
  const ws=String(spot.wind);
  txt(ws,24,26,wr,wg,wb,4);
  const we=24+ws.length*24;
  txt('KN',we+2,42,72,72,72,2);

  // Gust — scale 4
  txt(String(spot.gust),we+30,26,gr,gg,gb,4);

  // Dir — scale 2, right side, line 1
  txt(spot.dir,180,28,79,195,247,2);
  // Swell — scale 2, right side, line 2 — below dir with gap
  txt(spot.swell,180,44,79,195,247,2);

  // Wave — starts after swell text
  wave(50,spot.angle);

  // ── DIVIDER ──
  divider(70);

  // ── PAST 6H ──
  txt('PAST 6H',4,73,48,48,48,2);

  // ── HISTORY ──
  history(hist,spot.wind);

  // ── TIME LABELS ──
  timeLabels();
}

function blit(alpha){
  const ctx=canvas.getContext('2d');
  const id=ctx.createImageData(W,H);
  for(let i=0;i<buf.length;i+=4){
    id.data[i]=Math.round(buf[i]*alpha);
    id.data[i+1]=Math.round(buf[i+1]*alpha);
    id.data[i+2]=Math.round(buf[i+2]*alpha);
    id.data[i+3]=255;
  }
  ctx.putImageData(id,0,0);
}

const histories=SPOTS.map(function(_,si){
  return Array.from({length:64},function(_,i){
    return SPOTS[si].wind+Math.sin(i*0.18+si)*5+Math.sin(i*0.07+si*2)*3;
  });
});

let si=0;
function initDots(){
  const c=document.getElementById('spotDots');
  c.innerHTML='';
  SPOTS.forEach(function(_,i){
    const d=document.createElement('div');
    d.style.cssText='width:6px;height:6px;border-radius:50%;background:#333;transition:background 0.3s;display:inline-block;margin:0 4px;';
    c.appendChild(d);
  });
}
function updateDots(idx){
  const dots=document.getElementById('spotDots').children;
  for(let i=0;i<dots.length;i++)dots[i].style.background=i===idx?'#fff':'#333';
}

initDots();
render(SPOTS[0],histories[0]);
blit(1);
updateDots(0);

let fading=false;
function fadeOut(cb){
  fading=true;let a=1;
  (function step(){a-=0.08;if(a<=0){blit(0);cb();return;}blit(a);requestAnimationFrame(step);})();
}
function fadeIn(){
  let a=0;
  (function step(){a+=0.08;if(a>=1){blit(1);fading=false;return;}blit(a);requestAnimationFrame(step);})();
}
setInterval(function(){
  if(fading)return;
  fadeOut(function(){
    si=(si+1)%SPOTS.length;
    render(SPOTS[si],histories[si]);
    updateDots(si);
    fadeIn();
  });
},2500);

})();


;





// FAQ accordion
function toggleFaq(btn) {
  const answer = btn.nextElementSibling;
  const icon = btn.querySelector('.faq-icon');
  const isOpen = answer.style.display === 'block';
  // close all
  document.querySelectorAll('.faq-a').forEach(a => a.style.display = 'none');
  document.querySelectorAll('.faq-icon').forEach(i => { i.textContent = '+'; i.style.transform = 'rotate(0deg)'; });
  // open this one if it was closed
  if (!isOpen) {
    answer.style.display = 'block';
    icon.textContent = '×';
    icon.style.transform = 'rotate(0deg)';
  }
}

// Keyboard
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') closeModal();
});
