      line-height: 1.1 !important;
      margin-bottom: 14px !important;
    }
    .hero-inner p {
      font-size: 15px !important;
      margin-bottom: 24px !important;
      line-height: 1.6 !important;
    }

    /* CTA button full width */
    .hero-inner button {
      width: 100% !important;
      justify-content: center !important;
      padding: 15px 24px !important;
    }

    /* FAQ mobile */
    #faq-list .faq-q { font-size: 15px !important; }

    /* Trust grid mobile */
    .trust-grid { grid-template-columns: 1fr 1fr !important; }

    /* Gallery mobile — stack vertically */
    .gallery-grid { grid-template-columns: 1fr !important; }
    .gallery-grid > div:first-child { grid-row: auto !important; aspect-ratio: 16/9 !important; }
    .gallery-grid > div { aspect-ratio: 16/9 !important; }

    /* Trust items inline */
    .hero-trust {
      gap: 10px !important;
      flex-wrap: wrap;
      justify-content: flex-start;
    }
    .hero-trust span { font-size: 12px !important; }

    /* Trust strip */
    .trust-strip { gap: 16px; flex-wrap: wrap; padding: 16px 20px; justify-content: center; }
    .trust-item { font-size: 12px; }

    /* Features */
    .features { padding: 0 20px; margin: 48px auto; }
    .features-grid { grid-template-columns: 1fr; gap: 2px; }
    .feature-card:first-child { border-radius: 16px 16px 0 0; }
    .feature-card:last-child { border-radius: 0 0 16px 16px; }
    .feature-card { padding: 28px 24px; }
    .section-title { font-size: 28px !important; }

    /* How it works */
    .how { padding: 48px 20px; }
    .steps { grid-template-columns: 1fr; gap: 28px; }

    /* Specs */
    .specs { grid-template-columns: 1fr; gap: 32px; padding: 0 20px; margin: 48px auto; }

    /* Bottom CTA */
    .bottom-cta { padding: 48px 20px; }
    .bottom-cta h2 { font-size: 30px !important; }
    .bottom-cta button { width: 100% !important; justify-content: center !important; }

    /* Modal */
    .modal { padding: 32px 24px; }

    /* Footer */
    footer { padding: 20px; flex-direction: column; gap: 8px; text-align: center; }
    section[style*="max-width:720px"] { padding-left: 20px !important; padding-right: 20px !important; }
    section[style*="background:#f5f4f0"] { padding: 60px 20px !important; }
    section[style*="background:#f5f4f0"] > div { grid-template-columns: 1fr !important; gap: 32px !important; text-align: center; }
    section[style*="background:#f5f4f0"] > div > div:first-child { text-align: center; }
    section[style*="background:#f5f4f0"] p { font-size: 15px !important; }
  }
</style>
