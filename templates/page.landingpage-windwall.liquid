    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .section-title {
    font-family: 'Space Grotesk', sans-serif; font-weight:700;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin-bottom: 60px;
    max-width: 500px;
  }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }
  .feature-card {
    background: var(--off);
    padding: 36px 32px;
    transition: background 0.2s;
  }
  .feature-card:first-child { border-radius: 16px 0 0 16px; }
  .feature-card:last-child { border-radius: 0 16px 16px 0; }
  .feature-card:hover { background: #eeede9; }
  .feature-icon {
    width: 44px; height: 44px;
    background: var(--black);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    font-size: 20px;
  }
  .feature-title {
    font-family: 'Space Grotesk', sans-serif; font-weight:700;
    font-size: 20px;
    letter-spacing: -0.5px;
    margin-bottom: 10px;
  }
  .feature-text {
    font-size: 14px;
    color: #666;
    line-height: 1.65;
    font-weight: 300;
  }

  /* HOW IT WORKS */
  .how {
    background: var(--black);
    color: var(--white);
    padding: 100px 40px;
  }
  .how-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .how .section-tag { color: #555; }
  .how .section-title { color: var(--white); }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 60px;
  }
  .step { }
  .step-num {
    font-family: 'Space Grotesk', sans-serif; font-weight:700;
    font-size: 48px;
    color: #222;
    line-height: 1;
    margin-bottom: 16px;
  }
  .step-title {
    font-size: 16px;
    font-weight: 500;
    margin-bottom: 8px;
    color: #fff;
  }
  .step-text {
    font-size: 14px;
    color: #666;
    line-height: 1.65;
    font-weight: 300;
  }

  /* SPECS */
  .specs {
    max-width: 1100px;
    margin: 100px auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .specs-list {
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .specs-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
  }
  .specs-list li span:first-child { color: var(--muted); font-weight: 300; }
  .specs-list li span:last-child { font-weight: 500; }

  /* BOTTOM CTA */
  .bottom-cta {
    background: var(--off);
    padding: 100px 40px;
    text-align: center;
  }
  .bottom-cta h2 {
    font-family: 'Space Grotesk', sans-serif; font-weight:700;
    font-size: clamp(36px, 5vw, 60px);
    letter-spacing: -2px;
    line-height: 1.05;
    margin-bottom: 16px;
