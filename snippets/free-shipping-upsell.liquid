{%- doc -%}
  Brutalforce: free shipping box with checkbox add-ons (sits above the buy buttons).
  Ticking a row adds NOTHING to the cart. Ticked mugs are added together with the viewed
  product when the main Add to cart button is pressed (see assets/product-form.js).
  Text only (no progress bar). Message rule (mirrored in assets/free-shipping-upsell.js):
  - nothing chosen (no tick, quantity 1): amount = live cart subtotal only, exactly what the
    cart bar (snippets/free-shipping-bar.liquid) shows, so the two can never contradict.
  - something chosen (tick or quantity > 1): amount = cart + viewed x quantity + ticked mugs,
    i.e. what the cart will hold after pressing the main button.
  Threshold: Theme settings > Free shipping (settings.free_shipping_threshold).

  @param {block} block - The free_shipping_upsell block (settings: collection, heading_away, heading_unlocked)
  @param {product} product - The product currently being viewed (always excluded from the rows)
  @param {string} section_id - The main-product section id (to find its quantity input and buy buttons)
{%- enddoc -%}
{%- liquid
  assign upsell_collection = block.settings.collection
  if upsell_collection == blank
    assign upsell_collection = collections['ceramic-mugs']
  endif

  assign threshold_cents = settings.free_shipping_threshold | default: 30 | times: 100
  # First render: nothing is ticked and quantity is 1, so the message reflects the real cart only.
  assign seed_cents = product.selected_or_first_available_variant.price | default: 0
  assign projected_cents = cart.items_subtotal_price

  assign remaining_cents = threshold_cents | minus: projected_cents
  if remaining_cents < 0
    assign remaining_cents = 0
  endif

  assign heading_away = block.settings.heading_away | default: 'Add one for your crew and your whole order ships free'
  assign heading_unlocked = block.settings.heading_unlocked | default: 'Free shipping unlocked — your order ships free'
-%}

{%- capture upsell_rows -%}
  {%- assign shown = 0 -%}
  {%- for upsell_product in upsell_collection.products limit: 24 -%}
    {%- if shown >= 2 -%}{%- break -%}{%- endif -%}
    {%- if upsell_product.id == product.id or upsell_product.available == false -%}{%- continue -%}{%- endif -%}
    {%- assign upsell_variant = upsell_product.first_available_variant -%}
    {%- if upsell_variant == blank or upsell_variant.available == false -%}{%- continue -%}{%- endif -%}
    {%- assign shown = shown | plus: 1 -%}
    {%- assign upsell_alt = upsell_product.featured_image.alt | default: upsell_product.title | escape -%}
    {%- assign input_id = 'FsUpsell-' | append: section_id | append: '-' | append: upsell_variant.id -%}
    <li class="fs-upsell__item">
      <input
        type="checkbox"
        class="fs-upsell__checkbox visually-hidden"
        id="{{ input_id }}"
        value="{{ upsell_variant.id }}"
        data-price="{{ upsell_variant.price }}"
        data-handle="{{ upsell_product.handle }}"
        data-title="{{ upsell_product.title | escape }}"
      >
      <label class="fs-upsell__row" for="{{ input_id }}">
        <span class="fs-upsell__box" aria-hidden="true">
          {{- 'icon-lucide-check.svg' | inline_asset_content -}}
        </span>
        <span class="fs-upsell__media">
          {%- if upsell_product.featured_image != blank -%}
            {{
              upsell_product.featured_image
              | image_url: width: 168
              | image_tag:
                loading: 'lazy',
                width: 48,
                height: 48,
                sizes: '48px',
                widths: '48, 96, 144',
                class: 'fs-upsell__img',
                alt: upsell_alt
            }}
          {%- endif -%}
        </span>
        <span class="fs-upsell__title">{{ upsell_product.title | escape }}</span>
        <span class="fs-upsell__price">
          {%- if upsell_variant.compare_at_price > upsell_variant.price -%}
            <s class="fs-upsell__compare">
              {%- if settings.currency_code_enabled -%}
                {{- upsell_variant.compare_at_price | money_with_currency -}}
              {%- else -%}
                {{- upsell_variant.compare_at_price | money -}}
              {%- endif -%}
            </s>
          {%- endif -%}
          <span class="fs-upsell__now">
            {%- if settings.currency_code_enabled -%}
              {{- upsell_variant.price | money_with_currency -}}
            {%- else -%}
              {{- upsell_variant.price | money -}}
            {%- endif -%}
          </span>
        </span>
      </label>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- if shown > 0 -%}
  {{ 'component-free-shipping-upsell.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'free-shipping-upsell.js' | asset_url }}" defer="defer"></script>

  <free-shipping-upsell
    class="fs-upsell{% if remaining_cents == 0 %} is-unlocked{% endif %}"
    id="FreeShippingUpsell-{{ section_id }}"
    data-section-id="{{ section_id }}"
    data-threshold="{{ threshold_cents }}"
    data-seed="{{ seed_cents }}"
    data-money-format="{{ shop.money_format | escape }}"
    data-text-away="{{ heading_away | escape }}"
    data-text-unlocked="{{ heading_unlocked | escape }}"
    {{ block.shopify_attributes }}
  >
    <div class="fs-upsell__header">
      <span class="fs-upsell__icon">{{ 'icon-lucide-truck.svg' | inline_asset_content }}</span>
      <p class="fs-upsell__heading" data-fs-heading aria-live="polite">
        {%- if remaining_cents == 0 -%}
          {{- heading_unlocked | escape -}}
        {%- else -%}
          {{- heading_away | escape -}}
        {%- endif -%}
      </p>
    </div>
    <ul class="fs-upsell__list" role="list">
      {{ upsell_rows }}
    </ul>
    <p class="fs-upsell__note hidden" data-fs-note role="status"></p>
  </free-shipping-upsell>
{%- endif -%}
